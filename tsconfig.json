{
    "compilerOptions": {
        "target": "ES2020",
        "module": "es2022",
        "moduleResolution": "node",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*", "declarations.d.ts"],
    "exclude": ["node_modules"]
}
